# === Chrome 拡張 ===
node_modules/
dist/
build/
# Chrome Web Store 提出用 zip / crx
*.zip
*.crx
*.xpi

# === OS / エディタ ===
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# === ログ・一時・スクラッチ ===
*.log
*.jsonl
*.tmp
*.bak
*.orig
*.rej

# === AI ツールのローカル状態（トークンを含む可能性あり） ===
.claude/
.codex-tmp/
# many-ai-cli が opencode セッション中だけ cwd に書く permission 設定と排他ロック
# (opencode.json.many-ai-cli.lock)。セッションが kill されると置き去りになる。
# 完全一致だと lock 側が漏れるため前方一致で拾う。
opencode.json*

# === ツール生成キャッシュ（アカウント ID 等の識別子を含み得る・追跡しない） ===
.wrangler/
.vercel/
.netlify/
.firebase/
.turbo/
.parcel-cache/
.terraform/
.serverless/
**/supabase/.temp/

# === ローカル/プライベート追記（fresh public clone から除外） ===
# docs/local/ は "local"（その環境限定・非公開）の名のとおり ignore する。
# ローカル grep は追跡外でも効く。公開したい開発ドキュメントは docs/ 直下へ置く。
.env
.env.*
!.env.example
*.local
*.local.*
*.local.md
*.local.json
scripts/local/
docs/local/

# === 認証情報・secrets・鍵（public へ絶対に出さない） ===
*.pem
*.key
*.p12
*.pfx
*.ppk
id_rsa
id_dsa
id_ecdsa
id_ed25519
secrets.*
*.secret.*
*credential*
.netrc
.npmrc
.pypirc

# 開発計画 md はすべて docs/local/archive/ 配下で管理する。
# リポ直下 archive/ へ置くと公開追跡されるため封をする（offline-md-editor-viewer ef29430 と同じ対処）。
/archive/
# === obsidian-link: managed ===
/docs/obsidian/
# === /obsidian-link: managed ===
